-- Variante de producción de docker/postgres-init/00-roles.sql.
--
-- El script de desarrollo usa contraseñas fijas ('app_admin_dev_pw' /
-- 'app_user_dev_pw') a propósito, para no depender de secretos en un entorno
-- local. En producción eso es una credencial real expuesta en el repo — NO
-- usar el script de dev tal cual.
--
-- Cómo usar:
--   1. Copiar este archivo a docker/postgres-init/00-roles.sql EN EL SERVIDOR
--      (no en el repo — este archivo no debe commitearse con contraseñas reales).
--   2. Reemplazar <CAMBIAR_APP_ADMIN_PW> / <CAMBIAR_APP_USER_PW> por
--      contraseñas generadas (ej. `openssl rand -base64 32`).
--   3. Usar las MISMAS contraseñas en DATABASE_URL / DATABASE_ADMIN_URL del
--      .env de producción.
--   4. Solo aplica en la PRIMERA inicialización del volumen de Postgres
--      (docker-entrypoint-initdb.d solo corre si el volumen está vacío). Si
--      el volumen ya existe, cambiar la contraseña con ALTER ROLE en su lugar.

CREATE ROLE app_admin WITH LOGIN PASSWORD '<CAMBIAR_APP_ADMIN_PW>' BYPASSRLS CREATEROLE;
CREATE ROLE app_user WITH LOGIN PASSWORD '<CAMBIAR_APP_USER_PW>';

GRANT ALL PRIVILEGES ON DATABASE dashboard_comercial TO app_admin;
GRANT CONNECT ON DATABASE dashboard_comercial TO app_user;

ALTER SCHEMA public OWNER TO app_admin;
GRANT USAGE ON SCHEMA public TO app_user;

ALTER DEFAULT PRIVILEGES FOR ROLE app_admin IN SCHEMA public
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_user;
ALTER DEFAULT PRIVILEGES FOR ROLE app_admin IN SCHEMA public
  GRANT USAGE, SELECT ON SEQUENCES TO app_user;
