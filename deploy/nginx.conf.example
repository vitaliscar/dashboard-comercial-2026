# Reverse proxy Nginx → Next.js (bun run start, puerto 3000 por defecto).
# Copiar a /etc/nginx/sites-available/dashboard-comercial y enlazar en
# sites-enabled. Reemplazar dashboard.ccvenequip.com por el dominio real.
#
# HSTS se configura aquí a propósito (next.config.ts lo omite deliberadamente
# — ver el comentario en ese archivo).

server {
    listen 80;
    server_name dashboard.ccvenequip.com;

    # Certbot / Let's Encrypt renueva certificados vía este path.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name dashboard.ccvenequip.com;

    ssl_certificate     /etc/letsencrypt/live/dashboard.ccvenequip.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.ccvenequip.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # El limite real de subida del Excel es 350MB (src/app/api/carga/route.ts,
    # maxBytes) -- el archivo fuente solo crece con el tiempo (209MB al
    # momento de fijar este limite). Este valor debe quedar por ENCIMA de ese
    # limite, o Nginx corta la subida antes de que la app pueda devolver su
    # propio error 413 con mensaje claro. Si el Excel real vuelve a crecer,
    # subir ambos valores juntos (nunca solo uno).
    client_max_body_size 400m;
    # Timeouts largos: un upload de 300+MB por una conexion lenta puede
    # tardar varios minutos en llegar completo al backend.
    client_body_timeout 300s;

    # Carga de Excel: puede tardar varios minutos con archivos de 300+MB
    # (parseo + carga completa a Postgres, maxDuration=600s en la app).
    # Location aparte para no alargar el timeout del resto del sitio.
    location /api/carga {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 620s;
        proxy_send_timeout 620s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
