# Copiar a .env.local (o .env.production.local) en el servidor y completar.
# NUNCA commitear este archivo con valores reales.

NODE_ENV=production

# ── Postgres (docker-compose.prod.yml) ──────────────────────────────────────
# Generar contraseñas fuertes, ej.: openssl rand -base64 32
POSTGRES_USER=app_root
POSTGRES_PASSWORD=<CAMBIAR_CONTRASENA_FUERTE>
POSTGRES_DB=dashboard_comercial
POSTGRES_PORT=55432

# ── Roles de aplicación (creados por docker/postgres-init/00-roles.sql) ────
# app_user: rol sin BYPASSRLS, usado por `db` en src/db/index.ts
# app_admin: rol BYPASSRLS, usado por `dbAdmin` (migraciones, carga de Excel)
# Las contraseñas de estos roles se fijan en 00-roles.sql — cambiarlas ahí
# ANTES del primer arranque (el volumen de Postgres se crea una sola vez) y
# reflejar el mismo valor aquí.
DATABASE_URL=postgresql://app_user:<CAMBIAR>@localhost:55432/dashboard_comercial
DATABASE_ADMIN_URL=postgresql://app_admin:<CAMBIAR>@localhost:55432/dashboard_comercial

# ── Next.js ──────────────────────────────────────────────────────────────
# Dominio público real, usado por next.config.ts / cookies de sesión seguras.
# NEXT_PUBLIC_APP_URL=https://dashboard.ccvenequip.com
