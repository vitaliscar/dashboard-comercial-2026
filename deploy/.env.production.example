# Copiar a .env.local (o .env.production.local) en el servidor y completar.
# NUNCA commitear este archivo con valores reales.

NODE_ENV=production

# ── Postgres (docker-compose.prod.yml) ──────────────────────────────────────
# Generar contraseñas fuertes, ej.: openssl rand -base64 32
POSTGRES_USER=app_root
POSTGRES_PASSWORD=<CAMBIAR_CONTRASENA_FUERTE>
POSTGRES_DB=dashboard_comercial
POSTGRES_PORT=55432

# ── Roles de aplicación (creados por docker/postgres-init/00-roles.sh) ──────
# app_user: rol sin BYPASSRLS, usado por `db` en src/db/index.ts
# app_admin: rol BYPASSRLS, usado por `dbAdmin` (migraciones, carga de Excel)
# El script 00-roles.sh lee estas dos variables al arrancar el contenedor por
# PRIMERA vez (el volumen de Postgres se crea una sola vez) — deben quedar
# definidas ANTES de `docker compose up`, y coincidir con las contraseñas
# usadas en DATABASE_URL / DATABASE_ADMIN_URL de abajo.
APP_ADMIN_PASSWORD=<CAMBIAR_CONTRASENA_FUERTE_DISTINTA>
APP_USER_PASSWORD=<CAMBIAR_CONTRASENA_FUERTE_DISTINTA>

DATABASE_URL=postgresql://app_user:<MISMO_VALOR_QUE_APP_USER_PASSWORD>@localhost:55432/dashboard_comercial
DATABASE_ADMIN_URL=postgresql://app_admin:<MISMO_VALOR_QUE_APP_ADMIN_PASSWORD>@localhost:55432/dashboard_comercial

# ── Next.js ──────────────────────────────────────────────────────────────
# Dominio público real, usado por next.config.ts / cookies de sesión seguras.
# NEXT_PUBLIC_APP_URL=https://dashboard.ccvenequip.com
