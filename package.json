  "scripts": {
    "predev": "bun run build:worker",
    "dev": "next dev",
    "build:worker": "bun build src/lib/excel-parse.worker.ts --target=bun --outdir=worker-dist",
    "build": "bun run build:worker && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:excel": "bun run src/tests/excel.test.ts",
    "test:e2e": "playwright test",
    "test:load": "npx tsx scripts/load-test.ts",
    "test:smoke": "npx tsx scripts/smoke-test.ts",
    "alter-schema": "bun scripts/alter-schema.ts",
    "load-excel": "bun load-excel:full",
    "load-excel:full": "bun alter-schema && bun scripts/run-full-load.ts \"CCV Rendimiento.xlsx\""
  },
