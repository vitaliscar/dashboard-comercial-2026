# Postgres (Docker Compose local — ver docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_root_dev
POSTGRES_DB=dashboard_comercial
POSTGRES_PORT=55432
# Passwords de roles de app (init docker/postgres-init/00-roles.sh). Solo defaults de DEV.
APP_ADMIN_PASSWORD=app_admin_dev_pw
APP_USER_PASSWORD=app_user_dev_pw

DATABASE_URL=postgresql://app_user:app_user_dev_pw@localhost:55432/dashboard_comercial
DATABASE_ADMIN_URL=postgresql://app_admin:app_admin_dev_pw@localhost:55432/dashboard_comercial

# Token Bearer para GET /api/metrics (obligatorio en producción)
# METRICS_TOKEN=

# 1 = la carga Excel también reescribe passwords/roles/isActive (peligroso; solo seed inicial)
# EXCEL_SYNC_IDENTITY=
